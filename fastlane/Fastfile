# Fastfile — Amblyo
#
# Runs on GitHub Actions macOS runners. Nothing here needs a local Mac.
# docs/12-CICD-NO-MAC.md.

default_platform(:ios)

APP_ID  = "com.amblyo.app"
SCHEME  = "Amblyo"
TEAM_ID = "QAT93YWVSF"

# Simulators used for tests. One small phone and one large iPad, because the
# layout has to survive 320pt width and 13-inch split view, and neither of those
# is checkable by eye from Windows.
TEST_DEVICES = [
  "iPhone 16",
  "iPad Pro 13-inch (M4)"
].freeze

def asc_key
  app_store_connect_api_key(
    key_id:      ENV.fetch("ASC_KEY_ID"),
    issuer_id:   ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house:    false
  )
end

platform :ios do

  # The .xcodeproj does not exist in the repo — it is generated from
  # project.yml. That is what keeps a Windows workflow sane.
  #
  # But NOT every lane needs it. `bootstrap` only talks to Apple and to the
  # certificates git repo; it never opens the project. Generating one there
  # just adds a XcodeGen dependency to a workflow that has no reason to
  # install it — which is exactly how Bootstrap Signing #1 failed.
  before_all do
    Dir.chdir("..") { sh("xcodegen generate") }
  end

  # ---------------------------------------------------------------------------

  desc "Compile only. Fastest possible signal that the code is valid."
  lane :build_check do
    xcodebuild(
      project: "Amblyo.xcodeproj",
      scheme: SCHEME,
      configuration: "Debug",
      destination: "generic/platform=iOS Simulator",
      xcargs: "CODE_SIGNING_ALLOWED=NO build"
    )
  end

  desc "Build and run all tests. This is the CI lane."
  lane :ci do
    scan(
      project: "Amblyo.xcodeproj",
      scheme: SCHEME,
      devices: TEST_DEVICES,
      code_coverage: true,
      result_bundle: true,
      output_directory: "fastlane/test_output",
      # Signing is irrelevant for simulator tests, and requiring it here would
      # mean every pull request needed access to the match repo.
      xcargs: "CODE_SIGNING_ALLOWED=NO",
      fail_build: true
    )
  end

  # ---------------------------------------------------------------------------

  # ---------------------------------------------------------------------------

  desc "Archive and upload to TestFlight using Xcode automatic signing."
  lane :beta do
    key = asc_key

    # NO MATCH. This lane uses Xcode AUTOMATIC SIGNING driven by the App Store
    # Connect API key.
    #
    # WHY THE CHANGE:
    # match stores a shared certificate in a private git repo so a TEAM can sign
    # identically. That is a real problem - for a team. For a solo developer it
    # is pure overhead, and it added five failure points: a second repo, a PAT,
    # a base64 encoding of that PAT, an encryption passphrase, and match's own
    # clone logic. Every single release failure so far came from that chain, not
    # from the app.
    #
    # With `-allowProvisioningUpdates` plus the API key, xcodebuild asks Apple
    # directly for the certificate and profile it needs and creates them if they
    # are missing. No repo, no PAT, no passphrase, nothing to keep in sync.
    #
    # THE TRADE-OFF, STATED HONESTLY:
    # Automatic signing can create a new distribution certificate per machine,
    # and Apple caps you at 3. On one developer with one CI provider that is
    # fine. If a second build service ever needs to sign this app, revisit match
    # then - deliberately, not as a default.

    latest = latest_testflight_build_number(
      api_key: key,
      app_identifier: APP_ID,
      initial_build_number: 0
    )
    increment_build_number(build_number: latest + 1, xcodeproj: "Amblyo.xcodeproj")

    # xcodebuild needs the key as a FILE. The workflow writes it before this
    # lane runs and exports ASC_KEY_FILE with the absolute path.
    key_path = ENV.fetch("ASC_KEY_FILE")

    gym(
      project: "Amblyo.xcodeproj",
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "Amblyo.ipa",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}"
      ].join(" "),
      export_options: {
        signingStyle: "automatic",
        teamID: TEAM_ID,
        uploadSymbols: true
      }
    )

    changelog = if File.exist?("../CHANGELOG_LATEST.md")
                  File.read("../CHANGELOG_LATEST.md")
                else
                  "Internal build."
                end

    pilot(
      api_key: key,
      app_identifier: APP_ID,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: changelog
    )

    UI.success("Uploaded build #{latest + 1} to TestFlight.")
  end

  # ---------------------------------------------------------------------------

  desc "Capture App Store screenshots on the simulator."
  lane :screenshots do
    snapshot(
      project: "Amblyo.xcodeproj",
      scheme: "AmblyoUITests",
      clear_previous_screenshots: true,
      output_directory: "fastlane/screenshots"
    )
    UI.important("Now run: python3 scripts/make_screenshots.py to frame and caption them.")
  end

  # ---------------------------------------------------------------------------

  desc "Push metadata and screenshots, then submit for review."
  lane :release do
    key = asc_key

    deliver(
      api_key: key,
      app_identifier: APP_ID,
      submit_for_review: true,
      automatic_release: false,
      force: true,                          # skip the interactive HTML preview
      skip_binary_upload: true,             # the binary went up via `beta`
      precheck_include_in_app_purchases: true,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        content_rights_contains_third_party_content: false
      }
    )
  end

  desc "Dry run: validate metadata without submitting anything."
  lane :check_metadata do
    deliver(
      api_key: asc_key,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: false,
      submit_for_review: false
    )
  end

  # ---------------------------------------------------------------------------

  error do |lane, exception|
    UI.error("Lane #{lane} failed: #{exception.message}")
    UI.important("Signing problems? See docs/12-CICD-NO-MAC.md section 6.")
  end
end
