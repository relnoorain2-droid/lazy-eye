# fastlane match — certificates and provisioning profiles, encrypted, in a
# private git repo. This is what makes signing possible without a Mac: the
# runner decrypts them at build time, so you never touch Keychain Access.
#
# ⬜ Set git_url to your private certificates repo before running `bootstrap`.

git_url(ENV["MATCH_GIT_URL"] || "https://github.com/YOUR_GITHUB_USER/amblyo-certificates")
storage_mode("git")
git_branch("main")

app_identifier(["com.amblyo.app"])
team_id("QAT93YWVSF")

# Never let CI silently create new certificates. A runaway `match` can burn
# through your certificate limit and invalidate builds already in TestFlight.
# The beta lane overrides this with readonly:false so it can self-bootstrap
# on the very first release. This default protects every other code path.
readonly(true)
